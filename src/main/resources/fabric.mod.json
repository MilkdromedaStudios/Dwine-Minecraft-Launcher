{
  "schemaVersion": 1,
  "id": "dwine",
  "version": "${version}",
  "name": "Dwine",
  "description": "A sleek standalone Fabric client mod with a modern module menu, HUD editor, custom UI styling, and server-legal quality-of-life features.",
  "authors": ["Milkdromeda Studios"],
  "contact": {
    "homepage": "https://github.com/MilkdromedaStudios/Dwine-Minecraft-Launcher",
    "sources": "https://github.com/MilkdromedaStudios/Dwine-Minecraft-Launcher"
  },
  "license": "MIT",
  "icon": "assets/dwine/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.dwine.DwineClient"]
  },
  "mixins": ["dwine.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
